# Bu fayl real dəyər saxlamır — yalnız hansı environment variable-ların
# mövcud olduğunu sənədləşdirir. Real .env HEÇ VAXT commit edilməməlidir
# (bax .dockerignore və gələcək Gate 3 — Gitleaks secret detection).

PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# CORS: boş buraxılsa bütün origin-lər rədd edilir (deny-by-default).
# Konkret frontend domain-i əlavə etmək üçün: CORS_ORIGIN=https://app.example.com
CORS_ORIGIN=

# Yalnız Ingress/LoadBalancer arxasında true olmalıdır.
TRUST_PROXY=false
